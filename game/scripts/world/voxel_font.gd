static func text_width(text: String, scale := 1) -> int:
	return maxi(text.length() * (W + 1) - 1, 0) * scale


## Writes `text` into `vol`. origin = voxel of the top-left pixel of the first
## letter; `u` = direction the text runs (as seen by the reader), rows go down -y.
## `depth` voxels thick along `d` (usually pointing out of the wall).
static func draw(vol: VoxelVolume, text: String, origin: Vector3i, u: Vector3i, value: int, scale := 1, depth := 1, d := Vector3i.ZERO) -> void:
	var cursor := 0
	for ch in text.to_upper():
		var g: Array = GLYPHS.get(ch, [])
		if not g.is_empty():
			for row in H:
				var line: String = g[row]
				for col in W:
					if line[col] != "#":
						continue
					for sy in scale:
						for sx in scale:
							var p := origin + u * ((cursor + col) * scale + sx) - Vector3i(0, row * scale + sy, 0)
							for k in depth:
								vol.set_voxel(p + d * k, value)
		cursor += W + 1
