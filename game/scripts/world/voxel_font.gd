	"Ь": ["#....", "#....", "#....", "####.", "#...#", "#...#", "####."],
	"Э": [".###.", "#...#", "....#", "..###", "....#", "#...#", ".###."],
	"Ю": ["#..#.", "#.#.#", "#.#.#", "###.#", "#.#.#", "#.#.#", "#..#."],
