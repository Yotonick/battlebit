	"Р": ["####.", "#...#", "#...#", "####.", "#....", "#....", "#...."],
	"С": [".###.", "#...#", "#....", "#....", "#....", "#...#", ".###."],
	"Т": ["#####", "..#..", "..#..", "..#..", "..#..", "..#..", "..#.."],
	"У": ["#...#", "#...#", "#...#", ".####", "....#", "#...#", ".###."],
	"Ф": ["..#..", ".###.", "#.#.#", "#.#.#", ".###.", "..#..", "..#.."],
